# Copy to .env (never commit .env). Every settings.yaml key can be overridden as FINAGENT__SECTION__KEY.
FINAGENT__LLM__PROVIDER=mock                    # mock | ollama | anthropic | bedrock
# FINAGENT__LLM__PROVIDERS__OLLAMA__MODEL=qwen2.5:3b-instruct
# FINAGENT__LLM__PROVIDERS__ANTHROPIC__MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=                            # only for provider=anthropic
# FINAGENT__RAG__VECTOR__EMBEDDER=ollama        # real semantic embeddings (nomic-embed-text)
FINAGENT__WEBHOOKS__SIGNING_SECRET=change-me-local-only
# FINAGENT__APP__API_KEY=change-me              # require X-API-Key on the HTTP API
# FINAGENT__APP__FIXED_NOW=null                 # use wall-clock time instead of the frozen demo clock
